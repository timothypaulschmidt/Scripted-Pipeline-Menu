# lab.env - the ONE place that knows hostnames, ports, users and names.
# Read by both the bash scripts (sourced) and the PowerShell scripts (parsed).
# Format: KEY=VALUE, no spaces around "=". Use quotes if a value has spaces or backslashes.
# Change a hostname or port here and every script follows.

GITHUB_USER=timothypaulschmidt
DOCKER_NS=timothypaulschmidt
NAMESPACE=ai-assistant
DOCKER_NETWORK=lab

# ---- where the project folders live on each machine --------------------------
WIN_ROOT='C:\Users\timschmidt\Documents\Projects'
QA_HOST=k3s-qa.fortinetlabs.com
QA_USER=administrator
QA_ROOT=/home/administrator
PROD_HOST=k3s.fortinetlabs.com
PROD_USER=ubuntu
PROD_ROOT=/home/ubuntu

# ---- the scripts repo itself (cloned at <root>/Scripted-Pipeline-Menu on every machine) ----
MENU_REPO=Scripted-Pipeline-Menu

# ---- the apps, in deploy order ----------------------------------------------
APPS="assistant mcp agents"

# Language models the AI Assistant's Ollama should have (downloaded by the *-07-pull-models script)
OLLAMA_MODELS="llama3.2:3b qwen3:4b qwen3:8b"

# Dev-only values (local machine, never used on QA or prod)
DEV_ADMIN_TOKEN=dev-admin-token
DEV_OLLAMA_URL=http://localhost:11434
DEV_OLLAMA_URL_DOCKER=http://host.docker.internal:11434

# ---- AI Assistant -------------------------------------------------------------
ASSISTANT_REPO=AI-Assistant
ASSISTANT_IMAGE=ai-assistant
ASSISTANT_DEPLOYMENT=ai-assistant
ASSISTANT_TAG_FILE=deploy/k8s/kustomization.yaml
ASSISTANT_QA_DEPLOY=deploy/overlays/qa
ASSISTANT_PROD_DEPLOY=deploy/overlays/prod
ASSISTANT_LOCAL_PORT=8080
ASSISTANT_CONTAINER_PORT=8080
ASSISTANT_CONTAINER=ai-assistant

# ---- MCP server (internal only: no NodePort, no public name) -------------------
MCP_REPO=MCP-Server
MCP_IMAGE=mcp-server
MCP_DEPLOYMENT=mcp-server
MCP_TAG_FILE=deploy/k8s/kustomization.yaml
MCP_QA_DEPLOY=deploy/k8s
MCP_PROD_DEPLOY=deploy/k8s
MCP_LOCAL_PORT=8000
MCP_CONTAINER_PORT=8000
MCP_CONTAINER=mcp-server

# ---- AI Agents ---------------------------------------------------------------
AGENTS_REPO=AI-Agents
AGENTS_IMAGE=ai-agents
AGENTS_DEPLOYMENT=ai-agents
AGENTS_TAG_FILE=deploy/k8s/kustomization.yaml
AGENTS_QA_DEPLOY=deploy/k8s
AGENTS_PROD_DEPLOY=deploy/k8s
AGENTS_LOCAL_PORT=8090
AGENTS_CONTAINER_PORT=8080
AGENTS_CONTAINER=ai-agents

# ---- addresses you open in a browser -------------------------------------------
QA_ASSISTANT_URL=http://ai-qa.fortinetlabs.com:30080
QA_AGENTS_URL=http://agents-qa.fortinetlabs.com:30090
PROD_ASSISTANT_URL=http://ai.fortinetlabs.com:30080
PROD_AGENTS_URL=http://agents.fortinetlabs.com:30090
# Address of the MCP server as the other apps see it inside the cluster (not a browser URL)
CLUSTER_MCP_URL=http://mcp-server:8000/mcp
